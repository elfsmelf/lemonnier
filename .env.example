# URL that form submissions are POSTed to (e.g. a Make.com / Zapier webhook).
# Must be NEXT_PUBLIC_* because the form runs client-side.
# If unset, the form "succeeds" locally and logs the payload to the console —
# useful for local dev, but in production you must set this in Vercel env vars.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Google Ads conversion tracking (Enhanced Conversions for Leads).
# OPTIONAL — these default to the values baked into lib/gtag.js. Only set them
# here if you need to point at a different Google Ads account. They are NOT
# secret (they ship in the page source).
# NEXT_PUBLIC_GADS_CONVERSION_ID=AW-16633269034
# NEXT_PUBLIC_GADS_CONVERSION_LABEL=0ImQCPjohrgcEKqWrvs9
